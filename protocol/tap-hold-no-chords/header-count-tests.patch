+ thInit(1,0,0);thAssign(0,0,2,CONFIG_ACTION_MACRO,0,0,0);thFinish(0);
+ for(unsigned address=0;address<256;address++){thSetAction(0,0,CONFIG_ACTION_MACRO,address);
