+/* Shared semantic fixture for independently encoded prototypes. */
+#ifndef TAP_HOLD_ALTERNATIVE_FIXTURE_H
+#define TAP_HOLD_ALTERNATIVE_FIXTURE_H
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
