new file mode 100644
--- /dev/null
+++ b/tests/global_sleep_fixture.h
@@ -0,0 +1,10 @@
+#define TEST_ENABLE_BITS 32
+#define TEST_FIRST_SELECTOR 0
+#define TEST_SELECTOR_COUNT 4
+#define TEST_15_SELECTOR 0
+#define TEST_MAX_RESET_PARAM 1
+#define TEST_AUX_MODE 0
+#define TEST_DUAL_MODE 1
+#define TEST_ONLY_FIRST 64
+#define TEST_ONLY_PARAM 1
+static const uint16_t testIntervals[] = {220,440,879,1758};
diff --git a/tests/global_sleep_test.c b/tests/global_sleep_test.c
new file mode 100644
--- /dev/null
+++ b/tests/global_sleep_test.c
@@ -0,0 +1,202 @@
+#define GLOBAL_SLEEP_INCLUSION
+/* Global-sleep experiment: real dispatcher, validator and timer implementation. */
+#include "timed_actions_test.c"
+#undef main
+#include "global_sleep_fixture.h"
+
+static uint8_t settings(uint8_t selector, uint8_t flags) {
+    return selector | TEST_ENABLE_BITS | ((flags & 1) ? CONFIG_SLEEP_CONSUME : 0) |
+        ((flags & 2) ? CONFIG_SLEEP_INDICATOR : 0) | ((flags & 4) ? CONFIG_SLEEP_DIM : 0);
+}
+static void sleepInit(uint8_t timers, uint8_t selector, uint8_t flags) {
+    probeInit(timers); activeConfig[CONFIG_HEADER_SLEEP] = settings(selector, flags);
+    actionsTimedReset(fine); actionsTakeLayerSelection();
+}
+static void invoke(uint8_t first, uint8_t param) {
+    uint8_t keys = PHYSICAL_VARIANT ? 3 : 6;
+    uint8_t size = PHYSICAL_VARIANT ? 15 : 22;
+    uint8_t offset = 9 + size * actionsLayer() + 2 * (keys + 2);
+    activeConfig[offset] = first; activeConfig[offset + 1] = param;
+    actionsRotate(0);
+}
+static void fineSteps(uint32_t ticks) {
+    while (ticks--) { fine++; actionsTimedPoll(fine); }
+}
+static void globalIntervals(void) {
+    for (uint8_t selector = TEST_FIRST_SELECTOR; selector < TEST_SELECTOR_COUNT; selector++) {
+        uint32_t interval = (uint32_t)testIntervals[selector] * 256;
+        for (uint8_t flags = 0; flags < 8; flags++) {
+            sleepInit(0, selector, flags);
+            advanceFine(interval - 1); assert(ledCalls == 0);
+            advanceFine(1); assert(ledCalls == 1);
+            assert(ledValue == ((flags & 4) ? 2 : 4));
+            advanceFine(interval * 2); assert(ledCalls == 3);
+            assert(!actionsTakeLayerSelection());
+            assert(!!actionsTimedInput() == !!(flags & 1));
+            assert(ledCalls == 4 && ledValue == 0);
+            assert(!!actionsTakeLayerSelection() == !!(flags & 2));
+            assert(!actionsTimedInput());
+            advanceFine(interval - 1); assert(ledCalls == 4);
+            actionsTimedInput();
+            advanceFine(interval - 1); assert(ledCalls == 4);
+            advanceFine(1); assert(ledCalls == 5);
+        }
+    }
+    for (uint8_t flags = 0; flags < 8; flags++) {
+        probeInit(0); activeConfig[CONFIG_HEADER_SLEEP] = settings(TEST_FIRST_SELECTOR, flags) & ~CONFIG_SLEEP_ENABLE_MASK;
+        actionsTimedReset(fine);
+        activeConfig[9 + (PHYSICAL_VARIANT ? 15 : 22) - 1] |= 2; // Old layer bit ignored.
+        advanceFine(1758UL * 512); assert(ledCalls == 0);
+        assert(!actionsTimedInput() && !actionsTakeLayerSelection());
+    }
+}
+static void layersAndSlots(void) {
+    uint32_t interval = (uint32_t)testIntervals[TEST_15_SELECTOR] * 256;
+    for (uint8_t timers = 0; timers <= CONFIG_TIMED_MAX; timers++) {
+        sleepInit(timers, TEST_15_SELECTOR, 3);
+        for (uint8_t i = 0; i < timers; i++) {
+            uint8_t offset = configTimedOffset() + i * CONFIG_TIMED_SIZE;
+            activeConfig[offset + 1] = CONFIG_ACTION_NONE; activeConfig[offset + 2] = 0;
+            setFlags(i, CONFIG_TIMED_CONSUME);
+        }
+        advanceFine(interval / 2);
+        probeLayer(1); actionsTakeLayerSelection();
+        advanceFine(interval / 2 - 1); assert(ledCalls == 0);
+        advanceFine(1); assert(ledCalls == 1);
+        probeLayer(0); actionsTakeLayerSelection(); assert(ledCalls == 1); // No implicit layer wake.
+        assert(actionsTimedInput()); assert(ledCalls == timers + 2);
+        assert(actionsTakeLayerSelection());
+    }
+    // A repeating relative-layer timer cannot prevent global sleep.
+    sleepInit(1, TEST_15_SELECTOR, 0);
+    uint8_t timer = configTimedOffset();
+    activeConfig[timer + 1] = CONFIG_ACTION_RELATIVE_LAYER; activeConfig[timer + 2] = 1;
+    activeConfig[timer + 3] = activeConfig[timer + 4] = 0;
+    advanceFine(interval); assert(ledCalls == 1);
+}
+static uint8_t expectedReset(uint8_t first, uint8_t param) {
+    return (first == 0x40 && param <= TEST_MAX_RESET_PARAM) ||
+        (TEST_AUX_MODE && first == 0x80 && param == 0);
+}
+static void actionValidation(void) {
+    // Exhaust all auxiliary nibble/parameter combinations at every action site.
+    for (uint8_t site = 0; site < 6; site++) {
+        for (uint8_t aux = 3; aux < 16; aux++) for (unsigned param = 0; param < 256; param++) {
+            probeInit(site == 3 || site == 4 ? 1 : 0);
+            uint8_t offset;
+            if (site == 0) offset = 9;
+            else if (site == 1) offset = 9 + 2 * ((PHYSICAL_VARIANT ? 3 : 6) + 2);
+            else if (site == 2) { testSetChordCount(1); offset = configTimedOffset() - 2; }
+            else if (site == 3 || site == 4) offset = configTimedOffset() + (site == 3 ? 1 : 3);
+            else offset = configTimedOffset(); // Macro definition.
+            activeConfig[offset] = aux << 4; activeConfig[offset + 1] = param;
+            probeSeal();
+            assert(!!configValid(activeConfig, PHYSICAL_VARIANT) == !!expectedReset(aux << 4, param));
+        }
+    }
+    probeInit(0);
+    uint8_t size = PHYSICAL_VARIANT ? 15 : 22;
+    for (unsigned raw = 0; raw < 256; raw++) {
+        activeConfig[CONFIG_HEADER_SLEEP] = raw; probeSeal();
+        assert(!!configValid(activeConfig, PHYSICAL_VARIANT) == (raw < 64));
+    }
+    activeConfig[CONFIG_HEADER_SLEEP] = CONFIG_SLEEP_DEFAULT;
+    for (unsigned opts = 0; opts < 256; opts++) {
+        activeConfig[9 + size - 1] = opts; probeSeal();
+        assert(configValid(activeConfig, PHYSICAL_VARIANT));
+    }
+}
+static void resetActions(void) {
+    uint32_t interval = (uint32_t)testIntervals[TEST_15_SELECTOR] * 256;
+    for (uint8_t flags = 0; flags < 8; flags++) for (uint8_t asleep = 0; asleep < 2; asleep++) {
+        sleepInit(0, TEST_15_SELECTOR, flags);
+        advanceFine(asleep ? interval : interval - 1);
+        invoke(0x40, 0);
+        assert(ledCalls == (asleep ? 2 : 0));
+        if (asleep) assert(ledCommand == CONFIG_LED_PRESET_SET && ledValue == 0);
+        assert(!actionsTakeLayerSelection());
+        assert(!actionsTimedInput()); // No built-in consumption or reminder remains.
+        advanceFine(interval - 1); assert(ledCalls == (asleep ? 2 : 0));
+        advanceFine(1); assert(ledCalls == (asleep ? 3 : 1));
+    }
+    // Clear every high-age field and fractional phase, including long timeouts.
+    for (uint8_t selector = TEST_FIRST_SELECTOR; selector < TEST_SELECTOR_COUNT; selector++) {
+        uint32_t full = (uint32_t)testIntervals[selector] * 256;
+        sleepInit(0, selector, 0);
+        advanceFine(full - 1); invoke(0x40, 0);
+        advanceFine(full - 1); assert(ledCalls == 0);
+        advanceFine(1); assert(ledCalls == 1);
+        invoke(0x40, 0); assert(ledCalls == 2 && !actionsTimedInput());
+        if (TEST_DUAL_MODE) {
+            sleepInit(0, selector, 3);
+            advanceFine(full - 1); invoke(TEST_ONLY_FIRST, TEST_ONLY_PARAM);
+            advanceFine(full - 1); assert(ledCalls == 0);
+            advanceFine(1); assert(ledCalls == 1);
+            invoke(TEST_ONLY_FIRST, TEST_ONLY_PARAM); assert(ledCalls == 1);
+            assert(actionsTimedInput() && ledCalls == 2 && actionsTakeLayerSelection());
+        }
+    }
+    // The action itself must not reset, execute or consume a user's pending timer.
+    for (uint8_t timers = 1; timers <= CONFIG_TIMED_MAX; timers++) {
+        sleepInit(timers, TEST_15_SELECTOR, 3);
+        for (uint8_t i = 0; i < timers; i++) {
+            uint8_t offset = configTimedOffset() + i * CONFIG_TIMED_SIZE;
+            activeConfig[offset + 1] = CONFIG_ACTION_NONE; activeConfig[offset + 2] = 0;
+            setFlags(i, CONFIG_TIMED_CONSUME | 128);
+        }
+        advanceFine(interval); assert(ledCalls == 1);
+        invoke(0x40, 0); assert(ledCalls == 2 && !actionsTakeLayerSelection());
+        assert(actionsTimedInput()); assert(ledCalls == 2 + timers);
+        assert(!actionsTakeLayerSelection());
+    }
+    // A timer with restart-on-input set must still expire despite explicit resets.
+    sleepInit(2, TEST_15_SELECTOR, 0);
+    uint8_t timer = configTimedOffset();
+    activeConfig[timer + 1] = 0x40; activeConfig[timer + 2] = 0;
+    activeConfig[timer + 3] = activeConfig[timer + 4] = 0;
+    activeConfig[timer + 6] = 2; setFlags(1, 128);
+    advanceFine(3UL * 256); assert(ledCalls == 1 && ledCommand == CONFIG_LED_KEY_SET);
+    // Timer firing just before or just after sleep has the same awake outcome.
+    for (uint8_t after = 0; after < 2; after++) {
+        sleepInit(1, TEST_15_SELECTOR, 3);
+        timer = configTimedOffset();
+        activeConfig[timer] = testIntervals[TEST_15_SELECTOR] + (after ? 0 : -2);
+        activeConfig[timer + 1] = 0x40; activeConfig[timer + 2] = 0;
+        activeConfig[timer + 3] = activeConfig[timer + 4] = 0;
+        fineSteps(interval + (after ? 256 : -256));
+        assert(ledCalls == (after ? 2 : 0));
+        if (after) assert(ledValue == 0);
+        assert(!actionsTakeLayerSelection() && !actionsTimedInput());
+    }
+    // Macro order, repetition and following keyboard output are preserved.
+    sleepInit(0, TEST_15_SELECTOR, 3); advanceFine(interval);
+    count = blocked = 0; reportLimit = 64;
+    timer = configTimedOffset();
+    activeConfig[timer] = 0x40; activeConfig[timer + 1] = 0;
+    activeConfig[timer + 2] = CONFIG_ACTION_KEY_TAP; activeConfig[timer + 3] = 4;
+    activeConfig[timer + 4] = 0;
+    invoke(CONFIG_ACTION_MACRO | 0x10, timer);
+    for (uint16_t now = 0; now < 200; now++) actionsPoll(now);
+    assert(ledCalls == 2 && count == 4); // Two key press/release pairs.
+    assert(!actionsTakeLayerSelection() && !actionsTimedInput());
+    if (TEST_DUAL_MODE) {
+        // Reset-only also executes in macro order without waking or consuming input.
+        sleepInit(0, TEST_15_SELECTOR, 3); advanceFine(interval);
+        timer = configTimedOffset(); count = blocked = 0; reportLimit = 64;
+        activeConfig[timer] = TEST_ONLY_FIRST; activeConfig[timer + 1] = TEST_ONLY_PARAM;
+        activeConfig[timer + 2] = CONFIG_ACTION_KEY_TAP; activeConfig[timer + 3] = 4;
+        activeConfig[timer + 4] = 0;
+        invoke(CONFIG_ACTION_MACRO, timer);
+        for (uint16_t now = 0; now < 200; now++) actionsPoll(now);
+        assert(ledCalls == 1 && count == 2 && !actionsTakeLayerSelection());
+        advanceFine(interval - 1); assert(ledCalls == 1);
+        assert(actionsTimedInput()); assert(ledCalls == 2 && actionsTakeLayerSelection());
+    }
+    // No LED policy restoration when awake, even with global sleep disabled.
+    probeInit(0); actionsTimedReset(fine); invoke(0x40, 0); assert(ledCalls == 0);
+}
+int main(void) {
+    crcReference(); validation(); timing(); highIntervals(); boundariesAndPhase(); layers();
+    globalIntervals(); layersAndSlots(); actionValidation(); resetActions();
+    return 0;
+}
