+static void testOutputsAndReset(void) {
+    const uint8_t holds[] = {CONFIG_ACTION_KEY_HOLD, CONFIG_ACTION_MOUSE_HOLD,
+        CONFIG_ACTION_CONSUMER_HOLD, CONFIG_ACTION_CONSUMER_MODIFIED_HOLD | 0x60};
