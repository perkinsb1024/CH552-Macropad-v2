+    for (uint8_t i = 0; i < inputs; i++) { bind(i, i); actionsPress(i, 65500 + i); }
+    for (uint8_t i = 0; i < inputs; i++) {
+        poll(65500 + i + (i + 1) * 32); assert(ledCalls == i + 1);
+    }
+    for (uint8_t i = 0; i < inputs; i++) actionsRelease(i, 1000);
