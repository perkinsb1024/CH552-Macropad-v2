+static void trace_reset(void) {
+  uint32_t irq = save_and_disable_interrupts();
+  probe_bus_trace = (probe_bus_trace_t){0};
+  restore_interrupts(irq);
+}
+
+static void trace_log(const char *at) {
+  static probe_bus_trace_t sample;
+  uint32_t irq = save_and_disable_interrupts();
+  sample = probe_bus_trace;
+  restore_interrupts(irq);
+  log_event("bulk_in_trace", ",\"at\":\"%s\",\"polls\":%lu,\"matched\":%lu,"
+    "\"mismatches\":%lu,\"naks\":%lu,\"stalls\":%lu,\"errors\":%lu,"
+    "\"first_pid\":%lu,\"first_expected_pid\":%lu,\"first_length\":%lu",
+    at, (unsigned long)sample.polls, (unsigned long)sample.matched,
+    (unsigned long)sample.mismatches, (unsigned long)sample.naks,
+    (unsigned long)sample.stalls, (unsigned long)sample.errors,
+    (unsigned long)sample.first_pid, (unsigned long)sample.first_expected,
+    (unsigned long)sample.first_len);
+  if (sample.first_len) log_bytes("bulk_in_first_packet", sample.first_data, sample.first_len);
+}
+
