@@ -0,0 +1,10 @@
+#ifndef PROBE_BUS_TRACE_H
+#define PROBE_BUS_TRACE_H
+#include <stdint.h>
+typedef struct {
+  uint32_t polls, matched, mismatches, naks, stalls, errors;
+  uint32_t first_len, first_pid, first_expected;
+  uint8_t first_data[64];
+} probe_bus_trace_t;
+extern volatile probe_bus_trace_t probe_bus_trace;
+#endif
