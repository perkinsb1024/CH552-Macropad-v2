 bool probe_parse_detect(const uint8_t *data, size_t len) {
-  return valid_reply(data, len, 0xa1, 6) && data[4] == 0x52 && data[5] == 0x11;
+  // A1's second byte is not uniformly zero: the real CH552 wildcard-detect
+  // capture returned A1 9F 02 00 52 11. Accept only observed header variants;
+  // do not relax A7 or substitute this byte for the actual chip/family fields.
+  return data && len == 6 && data[0] == 0xa1 &&
+    (data[1] == 0 || data[1] == 0x9f) && le16(data + 2) == 2 &&
+    data[4] == 0x52 && data[5] == 0x11;
 }
 
